`caml_format_int "%d"` compiles to `String`; other formats keep the runtime
call.

  $ . ./setup.sh
  $ cat > x.ml <<EOF
  > external format_int : string -> int -> string = "caml_format_int"
  > external format_int32 : string -> int32 -> string = "caml_int32_format"
  > let d x = format_int "%d" x
  > let x x = format_int "%x" x
  > let d32 x = format_int32 "%d" x
  > EOF
  $ melc x.ml
  // Generated by Melange
  'use strict';
  
  const Caml_format = require("melange.js/caml_format.js");
  
  const d = String;
  
  function x(x$1) {
    return Caml_format.caml_format_int("%x", x$1);
  }
  
  const d32 = String;
  
  module.exports = {
    d,
    x,
    d32,
  }
  /* No side effect */
