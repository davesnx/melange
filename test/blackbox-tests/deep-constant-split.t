Inside a function, a constant nested deeper than 3 levels is emitted with
its deeper parts in `const` temporaries, so that no object literal is
nested deeper than 3. Each call still allocates a fresh value; top-level
constants are not split.

  $ . ./setup.sh
  $ cat > x.ml <<EOF
  > type t = Leaf | Node of int * t
  > let deep () = Node (1, Node (2, Node (3, Node (4, Node (5, Leaf)))))
  > let shallow () = Node (1, Node (2, Node (3, Leaf)))
  > let top = Node (1, Node (2, Node (3, Node (4, Leaf))))
  > EOF
  $ melc x.ml
  // Generated by Melange
  'use strict';
  
  
  function deep(param) {
    const tmp = {
      TAG: /* Node */ 0,
      _0: 4,
      _1: {
        TAG: /* Node */ 0,
        _0: 5,
        _1: /* Leaf */ 0
      }
    };
    return {
      TAG: /* Node */ 0,
      _0: 1,
      _1: {
        TAG: /* Node */ 0,
        _0: 2,
        _1: {
          TAG: /* Node */ 0,
          _0: 3,
          _1: tmp
        }
      }
    };
  }
  
  function shallow(param) {
    return {
      TAG: /* Node */ 0,
      _0: 1,
      _1: {
        TAG: /* Node */ 0,
        _0: 2,
        _1: {
          TAG: /* Node */ 0,
          _0: 3,
          _1: /* Leaf */ 0
        }
      }
    };
  }
  
  const top = {
    TAG: /* Node */ 0,
    _0: 1,
    _1: {
      TAG: /* Node */ 0,
      _0: 2,
      _1: {
        TAG: /* Node */ 0,
        _0: 3,
        _1: {
          TAG: /* Node */ 0,
          _0: 4,
          _1: /* Leaf */ 0
        }
      }
    }
  };
  
  module.exports = {
    deep,
    shallow,
    top,
  }
  /* No side effect */
