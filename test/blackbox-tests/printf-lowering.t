Fully applied `Printf.sprintf`/`ksprintf` and box-free `Format.asprintf` with
a literal format compile to string concatenation; other call shapes keep the
format interpreter

  $ . ./setup.sh
  $ cat > dune-project <<EOF
  > (lang dune 3.8)
  > (using melange 0.1)
  > EOF
  $ cat > dune <<EOF
  > (melange.emit
  >  (target output)
  >  (alias mel)
  >  (preprocess (pps melange.ppx)))
  > EOF

  $ cat > x.ml <<'EOF'
  > let pp () x = "<" ^ x ^ ">"
  > let lowered s n f = Printf.sprintf "%s: %d %5.2f %S %a" s n f s pp s
  > let k n = Printf.ksprintf (fun s -> "[" ^ s ^ "]") "%04x" n
  > let fmt n = Format.asprintf "n=%i" n
  > let partial = Printf.sprintf "%d-%d" 1
  > let boxed n = Format.asprintf "@[%d@]" n
  > let sp fmt = (Sys.opaque_identity Printf.sprintf) fmt
  > let () =
  >   Js.log (lowered "x" 1 0.5 = sp "%s: %d %5.2f %S %a" "x" 1 0.5 "x" pp "x");
  >   Js.log (lowered "a\"b" 42 3.14159);
  >   Js.log (k 255);
  >   Js.log (fmt (-7));
  >   Js.log (partial 2);
  >   Js.log (boxed 3)
  > EOF

  $ dune build @mel
  $ cat _build/default/output/x.js
