A `case` body that declares bindings is printed in its own block, so that
closures created in one case do not share a context with the other cases.

  $ . ./setup.sh
  $ cat > x.ml <<EOF
  > type t = A of int * int | B of string | C of int list | D of int
  > let make = function
  >   | A (x, y) -> let s = x + y in fun k -> k * s
  >   | B s -> let n = String.length s in fun k -> k + n
  >   | C l -> let n = List.length l in fun k -> k - n
  >   | D d -> fun k -> k + d
  > EOF
  $ melc x.ml
